{
  "lastChangelogVersion": "0.85.1",
  "theme": "one-dark-pro",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "xhigh",
  "externalEditor": "nvim",
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/web-search.json)",
      "Read(**/openai-server-compaction.json)",
      "Read(**/auth.json)",
      "Read(**/*-secrets.json)",
      "Read(**/*.key.json)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Workflow",
      "Ask_user",
      "Task",
      "Memory",
      "Scratchpad",
      "Recall",
      "Lsp_diagnostics",
      "Bash_output",
      "Kill_shell",
      "Intercom_peers",
      "Intercom_send",
      "Intercom_ask",
      "Web_search",
      "Source_check",
      "Fetch_content",
      "Get_search_content"
    ],
    "allowDestructive": [],
    "destructiveOverridesAllow": true,
    "askWithoutUi": "deny",
    "auto": {
      "model": "cheap"
    }
  },
  "compaction": {
    "enabled": true
  },
  "dynamicWorkflow": {
    "alwaysOn": true
  },
  "contextDiet": {
    "dropOldReasoning": false
  },
  "packages": [
    "npm:pi-provider-qoder@github:OysterD3/pi-provider-qoder#506df9a",
    "npm:pi-web-access",
    "npm:pi-openai-fast-mode",
    "git:github.com/algal/pi-openai-server-compaction@c6d593087709e9481223dc6c6c2269b371b5e055",
    "npm:@ff-labs/pi-fff@0.10.1",
    "npm:pi-mcp-adapter"
  ],
  "models": {
    "active": "openai",
    "providers": {
      "openai": {
        "session": "openai-codex/gpt-6-astra:xhigh",
        "frontier": "openai-codex/gpt-6-astra:xhigh",
        "fast": "openai-codex/gpt-5.6-terra:medium",
        "cheap": "openai-codex/gpt-5.6-luna:high"
      },
      "anthropic": {
        "session": "anthropic/claude-opus-5",
        "frontier": "anthropic/claude-opus-5",
        "fast": "anthropic/claude-sonnet-5",
        "cheap": "anthropic/claude-haiku-4-5"
      },
      "qoder": {
        "session": "qoder/ultimate",
        "frontier": "qoder/ultimate",
        "fast": "qoder/lite",
        "cheap": "qoder/lite"
      },
      "deepseek": {
        "session": "deepseek/deepseek-v4-flash",
        "frontier": "deepseek/deepseek-v4-flash",
        "fast": "deepseek/deepseek-v4-flash",
        "cheap": "deepseek/deepseek-v4-flash"
      },
      "mixed": {
        "session": "openai-codex/gpt-5.6-sol:max",
        "frontier": "openai-codex/gpt-5.6-sol:max",
        "fast": "opencode-go/deepseek-v4-flash:max",
        "cheap": "opencode-go/deepseek-v4-flash:max"
      }
    }
  },
  "showCacheMissNotices": true,
  "hideThinkingBlock": true,
  "retry": {
    "enabled": true
  }
}
