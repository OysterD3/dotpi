{
  "lastChangelogVersion": "0.87.1",
  "theme": "one-dark-pro",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "defaultThinkingLevel": "xhigh",
  "externalEditor": "nvim",
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/web-search.json)",
      "Read(**/openai-server-compaction.json)",
      "Read(**/auth.json)",
      "Read(**/*-secrets.json)",
      "Read(**/*.key.json)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Workflow",
      "Ask_user",
      "Task",
      "Memory",
      "Scratchpad",
      "Lsp_diagnostics",
      "Bash_output",
      "Kill_shell",
      "Intercom_peers",
      "Intercom_send",
      "Intercom_ask",
      "Web_search",
      "Source_check",
      "Fetch_content",
      "Get_search_content"
    ],
    "allowDestructive": [],
    "destructiveOverridesAllow": true,
    "askWithoutUi": "deny",
    "auto": {
      "model": "openai-codex/gpt-6-luna:high"
    }
  },
  "compaction": {
    "enabled": true
  },
  "dynamicWorkflow": {
    "alwaysOn": true,
    "model": "openai-codex/gpt-6-sol",
    "thinking": "high"
  },
  "packages": [
    "npm:pi-provider-qoder@github:OysterD3/pi-provider-qoder#063a31a",
    "npm:pi-web-access",
    "npm:pi-openai-fast-mode",
    "git:github.com/algal/pi-openai-server-compaction@c6d593087709e9481223dc6c6c2269b371b5e055",
    "npm:@ff-labs/pi-fff@0.10.1",
    "npm:pi-mcp-adapter",
    "npm:pi-cache-optimizer"
  ],
  "showCacheMissNotices": true,
  "hideThinkingBlock": true,
  "retry": {
    "enabled": true
  },
  "goal": {
    "model": "openai-codex/gpt-6-astra:medium"
  },
  "recap": {
    "model": "openai-codex/gpt-6-luna:low"
  }
}
