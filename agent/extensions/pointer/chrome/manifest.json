{
	"manifest_version": 3,
	"name": "pi pointer",
	"version": "0.1.0",
	"description": "Select elements on the page and point the pi coding agent at their source.",
	"key": "",
	"minimum_chrome_version": "116",
	"permissions": [
		"activeTab",
		"scripting",
		"nativeMessaging"
	],
	"action": {
		"default_title": "pi pointer — select elements (Alt+Shift+P)"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+P"
			},
			"description": "Show or hide the pi pointer bar"
		}
	},
	"background": {
		"service_worker": "background.js"
	}
}
