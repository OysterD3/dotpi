{
  "theme": "one-dark-pro",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "externalEditor": "nvim",
  "quietStartup": true,
  "steeringMode": "all",
  "followUpMode": "all",
  "collapseChangelog": true,
  "models": {
    "active": "openai",
    "providers": {
      "openai": {
        "session": "openai-codex/gpt-5.6-sol:max",
        "frontier": "openai-codex/gpt-5.6-sol",
        "fast": "openai-codex/gpt-5.6-terra",
        "cheap": "openai-codex/gpt-5.6-luna"
      },
      "anthropic": {
        "session": "anthropic/claude-opus-5:high",
        "frontier": "anthropic/claude-opus-5",
        "fast": "anthropic/claude-sonnet-5",
        "cheap": "anthropic/claude-haiku-4-5"
      },
      "qoder": {
        "session": "qoder/ultimate",
        "frontier": "qoder/ultimate",
        "fast": "qoder/auto",
        "cheap": "qoder/lite"
      }
    }
  },
  "permissions": {
    "defaultMode": "askDestructive",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/web-search.json)",
      "Read(**/openai-server-compaction.json)",
      "Read(**/auth.json)",
      "Read(**/*-secrets.json)",
      "Read(**/*.key.json)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Workflow",
      "Ask_user",
      "Task",
      "Memory",
      "Scratchpad",
      "Lsp_diagnostics",
      "Bash_output",
      "Kill_shell",
      "Intercom_peers",
      "Intercom_send",
      "Intercom_ask",
      "Web_search",
      "Source_check",
      "Fetch_content",
      "Get_search_content"
    ],
    "additionalDirectories": [],
    "allowDestructive": [],
    "destructiveOverridesAllow": true,
    "askWithoutUi": "deny",
    "auto": {
      "model": "cheap",
      "skipReadOnly": true,
      "onError": "allow",
      "timeoutMs": 10000
    }
  },
  "goal": {
    "model": "cheap"
  },
  "scratchpad": {
    "enabled": true,
    "root": ""
  },
  "packages": [
    "npm:pi-provider-qoder@github:OysterD3/pi-provider-qoder#6956615",
    "npm:pi-web-access@0.17.1",
    "npm:@ff-labs/pi-fff@0.10.1",
    "npm:@ryan_nookpi/pi-extension-codex-fast-mode@0.2.6",
    "git:github.com/algal/pi-openai-server-compaction@c6d593087709e9481223dc6c6c2269b371b5e055"
  ],
  "retry": {
    "enabled": true
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "contextDiet": {
    "enabled": true,
    "highWaterRatio": 0.8,
    "targetRatio": 0.55,
    "keepRecentResults": 24,
    "keepImages": 3,
    "minResultBytes": 512,
    "dropOldReasoning": false,
    "keepRecentReasoning": 10
  }
}
