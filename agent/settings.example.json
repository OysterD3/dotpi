{
  "theme": "one-dark-pro",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "medium",
  "externalEditor": "nvim",
  "models": {
    "active": "openai",
    "providers": {
      "openai": {
        "session": "openai-codex/gpt-5.6-sol",
        "frontier": "openai-codex/gpt-5.6-sol",
        "fast": "openai-codex/gpt-5.6-terra",
        "cheap": "openai-codex/gpt-5.6-luna"
      },
      "anthropic": {
        "session": "anthropic/claude-opus-5",
        "frontier": "anthropic/claude-opus-5",
        "fast": "anthropic/claude-sonnet-5",
        "cheap": "anthropic/claude-haiku-4-5"
      },
      "qoder": {
        "session": "qoder/ultimate",
        "frontier": "qoder/ultimate",
        "fast": "qoder/auto",
        "cheap": "qoder/lite"
      }
    }
  },
  "scratchpad": {
    "enabled": true,
    "retainDays": 7
  },
  "permissions": {
    "defaultMode": "askDestructive",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa)",
      "Read(**/*.pem)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Write(**/.env)",
      "Edit(**/.env)"
    ],
    "ask": [],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)"
    ],
    "allowDestructive": [],
    "destructiveOverridesAllow": true,
    "askWithoutUi": "deny",
    "auto": {
      "model": "cheap",
      "skipReadOnly": true,
      "onError": "allow",
      "timeoutMs": 10000
    }
  },
  "advisor": {
    "model": "frontier"
  },
  "goal": {
    "model": "cheap"
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000,
    "steer": true,
    "thinking": "low",
    "maxWords": 700,
    "compactAtPercent": 80,
    "compactAtTokens": 0
  }
}
